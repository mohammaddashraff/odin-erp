DATABASE_ADMIN_URL=postgresql://odin:odin_local_only@127.0.0.1:5433/odin_erp
DATABASE_URL=postgresql://odin_app:odin_app_local_only@127.0.0.1:5433/odin_erp
API_PORT=8081
NEXT_PUBLIC_API_BASE=/api
ODIN_TOKEN_SECRET=replace-with-at-least-32-random-characters
# Optional for local development; production requires a unique 32-byte key (for example: openssl rand -base64 32).
ODIN_MFA_ENCRYPTION_KEY=
ODIN_REQUIRE_PRIVILEGED_MFA=false
# Disposable demo deployments only. Never enable on a deployment containing real data.
ODIN_ALLOW_SHARED_DEMO_LOGINS=false
NEXT_PUBLIC_ODIN_DEMO_MODE=false
ODIN_SESSION_IDLE_MINUTES=30
ODIN_PRIVILEGED_SESSION_HOURS=8
ODIN_WEB_ORIGIN=http://127.0.0.1:8080
ODIN_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080
ENABLE_SWAGGER=true
