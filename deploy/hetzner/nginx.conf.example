# Separate vhost only. Merge into the existing nginx installation after nginx -t.
# Do not replace the host's main configuration or other applications' sites.
server {
    listen 80;
    server_name av8.odin-ltd.com;
    location ^~ /.well-known/acme-challenge/ { root /var/www/av8-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    server_name av8.odin-ltd.com;
    ssl_certificate /etc/letsencrypt/live/av8.odin-ltd.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/av8.odin-ltd.com/privkey.pem;
    client_max_body_size 25m;
    location / {
        proxy_pass http://127.0.0.1:18181;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 75s;
        proxy_send_timeout 75s;
    }
}
