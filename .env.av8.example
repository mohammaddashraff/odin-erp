# Documentation only. Generate private values with scripts/av8/init-local.mjs.
# The retained original .env is deliberately NOT loaded by AV8.
AV8_ENV=dev
AV8_OUTBOUND=disabled
AV8_JOBS=disabled
DATABASE_ADMIN_URL=postgresql://av8_owner:GENERATED_PRIVATE_PASSWORD@127.0.0.1:5548/av8_dev
DATABASE_URL=postgresql://av8_runtime:DIFFERENT_GENERATED_PASSWORD@127.0.0.1:5548/av8_dev
API_PORT=8181
API_ORIGIN=http://127.0.0.1:8181
ODIN_WEB_ORIGIN=http://127.0.0.1:8180
ODIN_ALLOWED_ORIGINS=http://127.0.0.1:8180,http://localhost:8180
ODIN_TOKEN_SECRET=GENERATE_AT_LEAST_40_RANDOM_CHARACTERS
ODIN_MFA_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_HEX
ODIN_REQUIRE_PRIVILEGED_MFA=false
ODIN_ALLOW_SHARED_DEMO_LOGINS=false
NEXT_PUBLIC_ODIN_DEMO_MODE=false
ODIN_UI_BUILD_DIR=.next-av8
NODE_ENV=development
# Test uses a DIFFERENT cluster, av8_test, port 5549 and different secrets.
