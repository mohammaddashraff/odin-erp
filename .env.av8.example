# Documentation only. Generate private values with scripts/av8/init-local.mjs.
# The retained original .env is deliberately NOT loaded by AV8.
AV8_ENV=dev
AV8_OUTBOUND=disabled
AV8_JOBS=disabled
DATABASE_ADMIN_URL=postgresql://av8_owner:GENERATED_PRIVATE_PASSWORD@127.0.0.1:5548/av8_dev
DATABASE_URL=postgresql://av8_runtime:DIFFERENT_GENERATED_PASSWORD@127.0.0.1:5548/av8_dev
API_PORT=8181
API_ORIGIN=http://127.0.0.1:8181
ODIN_WEB_ORIGIN=http://127.0.0.1:8180
ODIN_ALLOWED_ORIGINS=http://127.0.0.1:8180,http://localhost:8180
ODIN_TOKEN_SECRET=GENERATE_AT_LEAST_40_RANDOM_CHARACTERS
ODIN_MFA_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_HEX
ODIN_REQUIRE_PRIVILEGED_MFA=false
ODIN_ALLOW_SHARED_DEMO_LOGINS=false
NEXT_PUBLIC_ODIN_DEMO_MODE=false
ODIN_UI_BUILD_DIR=.next-av8
NODE_ENV=development
# Test uses a DIFFERENT cluster, av8_test, port 5549 and different secrets.
# Named academic delivery is separate from disabled inherited integrations.
AV8_ACADEMIC_EMAIL_ENABLED=false
AV8_ACADEMIC_EMAIL_PROVIDER=resend
AV8_ACADEMIC_EMAIL_FROM=
AV8_ACADEMIC_EMAIL_REPLY_TO=
AV8_ACADEMIC_EMAIL_API_KEY=
AV8_ACADEMIC_TEST_RECIPIENTS=
AV8_ACADEMIC_WORKER_ENABLED=false
AV8_ACADEMIC_WORKER_USER_ID=
AV8_OPERATIONS_WORKER_ENABLED=false
AV8_OPERATIONS_WORKER_USER_ID=

# Hosted STAGING: a separate protected deployment configuration, never append to dev.
# Set AV8_ENV=staging and NODE_ENV=production. No staging target is provisioned here.
# Required identity fields (replace every placeholder; blank/incomplete values fail):
# AV8_STAGING_DB_HOST=<exact separate database DNS host>
# AV8_STAGING_DB_POOLER_HOST=<optional exact separate runtime pooler host>
# AV8_STAGING_DB_NAME=av8_staging_<approved_unique_name>
# AV8_STAGING_DB_ADMIN_ROLE=av8_staging_<approved_owner_name>
# AV8_STAGING_RESOURCE=av8-erp-staging:<approved_unique_resource_id>
# AV8_STAGING_PROJECT_ID=<separate API prj_... identifier>
# VERCEL_PROJECT_ID must match that API project's actual platform value.
# DATABASE_URL=postgresql://av8_runtime:<private>@<staging-host>/<staging-name>?sslmode=verify-full
# DATABASE_ADMIN_URL=postgresql://<staging-owner>:<different-private>@<direct-staging-host>/<staging-name>?sslmode=verify-full
# Optional DATABASE_URL_UNPOOLED / POSTGRES_URL_NON_POOLING must match the direct owner URL identity.
# ODIN_WEB_ORIGIN=https://<dedicated-staging-web-host>
# ODIN_ALLOWED_ORIGINS=https://<dedicated-staging-web-host>
# ODIN_REQUIRE_PRIVILEGED_MFA=true; ODIN_ALLOW_SHARED_DEMO_LOGINS=false
# AV8_SIMPLE_LOGIN=false; NEXT_PUBLIC_ODIN_DEMO_MODE=false; AV8_OUTBOUND=disabled; AV8_JOBS=disabled
# Supply separate token/MFA secrets. Do not copy dev or production secrets.
# No synthetic seed/reset is permitted. See docs/final-delivery/staging-configuration.md.

# Selected final target: HETZNER, using a separate protected configuration.
# AV8_HOSTING=hetzner
# AV8_ENV=production (or staging for the separate rehearsal)
# NODE_ENV=production
# AV8_HETZNER_DEPLOYMENT_ID=<unique 8-100 character lowercase identifier>
# AV8_HETZNER_RESOURCE=av8-erp-production:<same-deployment-id>
# AV8_HETZNER_DB_HOST=av8-postgres
# AV8_HETZNER_DB_NAME=av8_prod_<unique_name>
# AV8_HETZNER_DB_ADMIN_ROLE=av8_prod_<unique_owner>
# AV8_DB_TRANSPORT=PRIVATE_CONTAINER_NETWORK
# Private transport requires the owned isolated Compose network and NO published database port.
# DATABASE_URL=postgresql://av8_runtime:<private>@av8-postgres/<exact-name>?sslmode=disable
# DATABASE_ADMIN_URL=postgresql://<exact-owner>:<different-private>@av8-postgres/<exact-name>?sslmode=disable
# ODIN_WEB_ORIGIN=https://av8.odin-ltd.com
# ODIN_PUBLIC_ORIGIN=https://av8.odin-ltd.com
# ODIN_ALLOWED_ORIGINS=https://av8.odin-ltd.com
# API_ORIGIN=http://api:8181
# VERCEL and VERCEL_PROJECT_ID must be absent; secure MFA/demo/outbound settings above still apply.
# Staging uses av8_staging_ database/owner names and av8-erp-staging:<id> marker.
# SSH-only staging may explicitly select AV8_STAGING_PUBLIC_ORIGIN=http://127.0.0.1:<port1024+>
# with ODIN_WEB_ORIGIN/ODIN_PUBLIC_ORIGIN/ODIN_ALLOWED_ORIGINS equal that exact origin.
# Hosted schedulers call /api/av8/scheduler/tick with this distinct bearer secret.
# Disabled by default; enable only with scoped named worker identities and a hosted schedule.
AV8_SCHEDULER_ENABLED=false
AV8_SCHEDULER_SECRET=
AV8_SCHEDULER_APPLICATION_LIMIT=20
AV8_SCHEDULER_DISPATCH_LIMIT=1
