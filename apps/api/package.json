{
  "name": "@odin/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "prebuild": "prisma generate",
    "build": "nest build",
    "release:migrate": "prisma migrate deploy && tsx prisma/av8-seed.ts",
    "start:prod": "node ../../.av8/api/src/main.js",
    "lint": "tsc --noEmit",
    "test": "jest --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/av8-seed.ts",
    "db:reset": "node -e \"throw new Error('Reset is disabled; use a new isolated AV8 test database')\"",
    "integrity": "tsx src/scripts/integrity.ts",
    "build:vercel": "prisma generate"
  },
  "dependencies": {
    "@nestjs/common": "latest",
    "@nestjs/core": "latest",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "dotenv": "latest",
    "jsonwebtoken": "latest",
    "pdfkit": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest"
  },
  "devDependencies": {
    "@nestjs/cli": "latest",
    "@nestjs/testing": "latest",
    "@types/express": "latest",
    "@types/jest": "latest",
    "@types/jsonwebtoken": "latest",
    "@types/node": "latest",
    "@types/pdfkit": "latest",
    "@types/supertest": "latest",
    "jest": "latest",
    "prisma": "7.10.0",
    "supertest": "latest",
    "ts-jest": "latest",
    "tsx": "latest",
    "typescript": "6.0.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node"
  }
}
