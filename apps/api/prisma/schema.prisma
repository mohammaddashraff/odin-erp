generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DocumentType {
  QUOTATION
  SALES_ORDER
  DELIVERY_NOTE
  SALES_INVOICE
  SALES_RETURN
  CREDIT_NOTE
  PURCHASE_REQUEST
  PURCHASE_RFQ
  PURCHASE_ORDER
  GOODS_RECEIPT
  PURCHASE_BILL
  PURCHASE_RETURN
  WAREHOUSE_TRANSFER
  INVENTORY_ADJUSTMENT
  STOCK_COUNT
}

enum WorkflowStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
  CANCELLED
}

enum JournalStatus {
  DRAFT
  SUBMITTED
  APPROVED
  POSTED
  REJECTED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  COGS
  EXPENSE
  OTHER_INCOME
  OTHER_EXPENSE
}

enum PartyType {
  CUSTOMER
  SUPPLIER
}

enum PaymentKind {
  RECEIPT
  PAYMENT
}

enum PaymentMethod {
  CASH
  CARD
  BANK
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

enum PosSaleStatus {
  HELD
  COMPLETED
  RETURNED
}

enum BankAccountType {
  CASH
  BANK
  CARD_CLEARING
}

enum BankTransactionKind {
  RECEIPT
  PAYMENT
  TRANSFER_IN
  TRANSFER_OUT
}

enum PermissionOverrideEffect {
  GRANT
  DENY
}

enum DataScopeType {
  NONE
  OWN
  ASSIGNED
  TEAM
  BRANCH
  WAREHOUSE
  DEPARTMENT
  ALL
}

enum FieldAccessLevel {
  HIDDEN
  VIEW
  EDIT
}

model Tenant {
  id                   BigInt                   @id @default(autoincrement())
  name                 String
  baseCurrency         String                   @default("EGP") @map("base_currency")
  customerCodePrefix   String                   @default("CUS") @map("customer_code_prefix")
  negativeStock        Boolean                  @default(false) @map("negative_stock")
  makerChecker         Boolean                  @default(true) @map("maker_checker")
  approvalLimit        BigInt                   @default(5000000) @map("approval_limit_minor")
  resetVersion         Int                      @default(0) @map("reset_version")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  branches             Branch[]
  warehouses           Warehouse[]
  departments          Department[]
  employees            Employee[]
  currencies           Currency[]
  currencyRates        CurrencyRate[]
  masterSequences      MasterSequence[]
  refreshSessions      RefreshSession[]
  roles                Role[]
  users                User[]
  fiscalPeriods        FiscalPeriod[]
  accounts             Account[]
  sequences            DocumentSequence[]
  customers            Customer[]
  suppliers            Supplier[]
  itemCategories       ItemCategory[]
  units                UnitOfMeasure[]
  items                Item[]
  stockBalances        StockBalance[]
  stockMovements       StockMovement[]
  documents            Document[]
  documentLines        DocumentLine[]
  journals             JournalEntry[]
  journalLines         JournalLine[]
  payments             Payment[]
  allocations          PaymentAllocation[]
  approvals            ApprovalEvent[]
  auditEvents          AuditEvent[]
  posShifts            PosShift[]
  posSales             PosSale[]
  posSaleLines         PosSaleLine[]
  posTenders           PosTender[]
  bankAccounts         BankAccount[]
  bankTxns             BankTransaction[]
  bankStatements       BankStatement[]
  statementLines       BankStatementLine[]
  idempotency          IdempotencyKey[]
  permissions          Permission[]
  rolePermissions      RolePermission[]
  userRoles            UserRole[]
  permissionOverrides  UserPermissionOverride[]
  roleLimits           RoleLimit[]
  roleDataScopes       RoleDataScope[]
  roleFieldPermissions RoleFieldPermission[]
  accessAuditLogs      AccessAuditLog[]

  @@map("tenants")
}

model Branch {
  id               BigInt             @id @default(autoincrement())
  tenantId         BigInt             @map("tenant_id")
  code             String
  name             String
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouses       Warehouse[]
  documents        Document[]
  journals         JournalEntry[]
  stockMoves       StockMovement[]
  posShifts        PosShift[]
  bankTxns         BankTransaction[]
  sequences        DocumentSequence[]
  defaultCustomers Customer[]         @relation("CustomerDefaultBranch")
  accessAuditLogs  AccessAuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("branches")
}

model Warehouse {
  id              BigInt          @id @default(autoincrement())
  tenantId        BigInt          @map("tenant_id")
  branchId        BigInt          @map("branch_id")
  code            String
  name            String
  active          Boolean         @default(true)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch          Branch          @relation(fields: [branchId], references: [id])
  sourceDocuments Document[]      @relation("DocumentWarehouse")
  targetDocuments Document[]      @relation("DocumentDestinationWarehouse")
  stockBalances   StockBalance[]
  stockMovements  StockMovement[]
  posShifts       PosShift[]
  accessAuditLogs AccessAuditLog[]

  @@unique([tenantId, code])
  @@index([tenantId, branchId])
  @@map("warehouses")
}

model Role {
  id                    BigInt                @id @default(autoincrement())
  tenantId              BigInt                @map("tenant_id")
  key                   String?
  name                  String
  description           String?
  permissions           Json
  active                Boolean               @default(true)
  archivedAt            DateTime?             @map("archived_at") @db.Timestamptz(3)
  createdAt             DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                 User[]
  additionalUsers       UserRole[]
  permissionAssignments RolePermission[]
  limits                RoleLimit[]
  dataScopes            RoleDataScope[]
  fieldPermissions      RoleFieldPermission[]
  accessAuditLogs       AccessAuditLog[]      @relation("AccessAuditSubjectRole")

  @@unique([tenantId, name])
  @@unique([tenantId, key])
  @@index([tenantId, active, archivedAt])
  @@map("roles")
}

model User {
  id                  BigInt                   @id @default(autoincrement())
  tenantId            BigInt                   @map("tenant_id")
  roleId              BigInt                   @map("role_id")
  email               String
  name                String
  passwordHash        String                   @map("password_hash")
  branchIds           Json                     @map("branch_ids")
  warehouseIds        Json                     @map("warehouse_ids")
  language            String                   @default("en")
  active              Boolean                  @default(true)
  tenant              Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role                Role                     @relation(fields: [roleId], references: [id])
  createdDocuments    Document[]               @relation("DocumentCreator")
  submittedDocuments  Document[]               @relation("DocumentSubmitter")
  approvedDocuments   Document[]               @relation("DocumentApprover")
  postedDocuments     Document[]               @relation("DocumentPoster")
  createdJournals     JournalEntry[]           @relation("JournalCreator")
  submittedJournals   JournalEntry[]           @relation("JournalSubmitter")
  approvedJournals    JournalEntry[]           @relation("JournalApprover")
  postedJournals      JournalEntry[]           @relation("JournalPoster")
  stockMovements      StockMovement[]
  payments            Payment[]
  approvals           ApprovalEvent[]
  auditEvents         AuditEvent[]
  openedShifts        PosShift[]               @relation("ShiftOpener")
  closedShifts        PosShift[]               @relation("ShiftCloser")
  posSales            PosSale[]
  bankTxns            BankTransaction[]
  bankStatements      BankStatement[]
  refreshSessions     RefreshSession[]
  additionalRoles     UserRole[]
  permissionOverrides UserPermissionOverride[] @relation("PermissionOverrideSubject")
  createdOverrides    UserPermissionOverride[] @relation("PermissionOverrideCreator")
  accessAuditActions  AccessAuditLog[]         @relation("AccessAuditActor")
  accessAuditSubjects AccessAuditLog[]         @relation("AccessAuditSubjectUser")
  employee            Employee?
  ownedCustomers      Customer[]               @relation("CustomerOwner")

  @@unique([tenantId, email])
  @@index([tenantId, roleId, active])
  @@map("users")
}

model Permission {
  id            BigInt                   @id @default(autoincrement())
  tenantId      BigInt                   @map("tenant_id")
  key           String
  module        String
  resource      String
  action        String
  description   String?
  active        Boolean                  @default(true)
  createdAt     DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant        Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roles         RolePermission[]
  userOverrides UserPermissionOverride[]

  @@unique([tenantId, key])
  @@index([tenantId, module, resource, action])
  @@map("permissions")
}

model RolePermission {
  id           BigInt     @id @default(autoincrement())
  tenantId     BigInt     @map("tenant_id")
  roleId       BigInt     @map("role_id")
  permissionId BigInt     @map("permission_id")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, permissionId])
  @@index([tenantId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  userId    BigInt   @map("user_id")
  roleId    BigInt   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, roleId])
  @@index([tenantId, roleId])
  @@map("user_roles")
}

model UserPermissionOverride {
  id           BigInt                   @id @default(autoincrement())
  tenantId     BigInt                   @map("tenant_id")
  userId       BigInt                   @map("user_id")
  permissionId BigInt                   @map("permission_id")
  effect       PermissionOverrideEffect
  reason       String?
  createdById  BigInt?                  @map("created_by_id")
  createdAt    DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                     @relation("PermissionOverrideSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy    User?                    @relation("PermissionOverrideCreator", fields: [createdById], references: [id], onDelete: SetNull)
  permission   Permission               @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, permissionId])
  @@index([tenantId, permissionId, effect])
  @@map("user_permission_overrides")
}

model RoleLimit {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  roleId    BigInt   @map("role_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, key])
  @@map("role_limits")
}

model RoleDataScope {
  id        BigInt        @id @default(autoincrement())
  tenantId  BigInt        @map("tenant_id")
  roleId    BigInt        @map("role_id")
  resource  String
  scope     DataScopeType
  config    Json?
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, resource])
  @@index([tenantId, resource, scope])
  @@map("role_data_scopes")
}

model RoleFieldPermission {
  id        BigInt           @id @default(autoincrement())
  tenantId  BigInt           @map("tenant_id")
  roleId    BigInt           @map("role_id")
  resource  String
  field     String
  access    FieldAccessLevel
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  role      Role             @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, roleId, resource, field])
  @@index([tenantId, resource, field, access])
  @@map("role_field_permissions")
}

model AccessAuditLog {
  id                  BigInt   @id @default(autoincrement())
  tenantId            BigInt?  @map("tenant_id")
  actorUserId         BigInt?  @map("actor_user_id")
  subjectUserId       BigInt?  @map("subject_user_id")
  subjectRoleId       BigInt?  @map("subject_role_id")
  action              String
  permissionKey       String?  @map("permission_key")
  previousValue       Json?    @map("previous_value")
  newValue            Json?    @map("new_value")
  companyId           String?  @map("company_id")
  branchId            BigInt?  @map("branch_id")
  warehouseId         BigInt?  @map("warehouse_id")
  resourceType        String?  @map("resource_type")
  resourceId          String?  @map("resource_id")
  requestedAction     String?  @map("requested_action")
  route               String?
  httpMethod          String?  @map("http_method")
  ipAddress           String?  @map("ip_address")
  userAgent           String?  @map("user_agent")
  sessionId           String?  @map("session_id")
  requestId           String?  @map("request_id")
  denialReason        String?  @map("denial_reason")
  dataScopeReason     String?  @map("data_scope_reason")
  fieldSecurityReason String?  @map("field_security_reason")
  roleLimitReason     String?  @map("role_limit_reason")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actorUser     User?    @relation("AccessAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  subjectUser   User?    @relation("AccessAuditSubjectUser", fields: [subjectUserId], references: [id], onDelete: SetNull)
  subjectRole   Role?    @relation("AccessAuditSubjectRole", fields: [subjectRoleId], references: [id], onDelete: SetNull)
  branch        Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([tenantId, actorUserId, action])
  @@index([tenantId, denialReason, createdAt])
  @@index([requestId])
  @@map("access_audit_logs")
}

model Department {
  id        BigInt     @id @default(autoincrement())
  tenantId  BigInt     @map("tenant_id")
  code      String
  name      String
  active    Boolean    @default(true)
  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employees Employee[]

  @@unique([tenantId, code])
  @@index([tenantId, name, active])
  @@map("departments")
}

model Employee {
  id             BigInt     @id @default(autoincrement())
  tenantId       BigInt     @map("tenant_id")
  departmentId   BigInt     @map("department_id")
  userId          BigInt?    @unique @map("user_id")
  code           String
  name           String
  jobTitle       String?    @map("job_title")
  salaryMinor     BigInt?    @map("salary_minor")
  salesEligible  Boolean    @default(false) @map("sales_eligible")
  branchIds      Json       @map("branch_ids")
  active         Boolean    @default(true)
  tenant         Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department     Department @relation(fields: [departmentId], references: [id])
  user           User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  salesDocuments Document[]

  @@unique([tenantId, code])
  @@index([tenantId, departmentId, active, salesEligible])
  @@index([tenantId, name])
  @@map("employees")
}

model Currency {
  id        BigInt  @id @default(autoincrement())
  tenantId  BigInt  @map("tenant_id")
  code      String
  name      String
  symbol    String
  precision Int     @default(2)
  active    Boolean @default(true)
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, active, name])
  @@map("currencies")
}

model CurrencyRate {
  id             BigInt   @id @default(autoincrement())
  tenantId       BigInt   @map("tenant_id")
  baseCurrency   String   @map("base_currency")
  targetCurrency String   @map("target_currency")
  rateMicros     BigInt   @map("rate_micros")
  rateDate       DateTime @map("rate_date") @db.Date
  source         String   @default("SYSTEM")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, baseCurrency, targetCurrency, rateDate])
  @@index([tenantId, targetCurrency, rateDate])
  @@map("currency_rates")
}

model MasterSequence {
  tenantId  BigInt @map("tenant_id")
  key       String
  prefix    String
  nextValue BigInt @default(1) @map("next_value")
  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, key])
  @@map("master_sequences")
}

model RefreshSession {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   BigInt    @map("tenant_id")
  userId     BigInt    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  persistent Boolean   @default(true)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime  @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, expiresAt])
  @@map("refresh_sessions")
}

model FiscalPeriod {
  id        BigInt   @id @default(autoincrement())
  tenantId  BigInt   @map("tenant_id")
  year      Int
  month     Int
  name      String
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  status    String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, year, month])
  @@index([tenantId, status, startDate])
  @@map("fiscal_periods")
}

model Account {
  id                 BigInt            @id @default(autoincrement())
  tenantId           BigInt            @map("tenant_id")
  code               String
  name               String
  type               AccountType
  parentId           BigInt?           @map("parent_id")
  postingAllowed     Boolean           @default(true) @map("posting_allowed")
  controlType        String?           @map("control_type")
  active             Boolean           @default(true)
  tenant             Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent             Account?          @relation("AccountTree", fields: [parentId], references: [id])
  children           Account[]         @relation("AccountTree")
  journalLines       JournalLine[]
  bankAccounts       BankAccount[]
  bankCounterparties BankTransaction[] @relation("BankCounterparty")

  @@unique([tenantId, code])
  @@index([tenantId, type, active])
  @@index([parentId])
  @@map("accounts")
}

model DocumentSequence {
  tenantId     BigInt @map("tenant_id")
  branchId     BigInt @map("branch_id")
  documentType String @map("document_type")
  fiscalYear   Int    @map("fiscal_year")
  nextValue    BigInt @default(1) @map("next_value")
  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  branch       Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([tenantId, branchId, documentType, fiscalYear])
  @@map("document_sequences")
}

model Customer {
  id                 BigInt     @id @default(autoincrement())
  tenantId           BigInt     @map("tenant_id")
  code               String
  name               String
  customerType       String     @default("BUSINESS") @map("customer_type")
  taxNumber          String?    @map("tax_number")
  registrationNumber String?    @map("registration_number")
  email              String?
  phone              String?
  address            String?
  billingAddress     String?    @map("billing_address")
  shippingAddress    String?    @map("shipping_address")
  city               String
  defaultBranchId    BigInt?    @map("default_branch_id")
  ownerUserId        BigInt?    @map("owner_user_id")
  creditLimitMinor   BigInt?    @map("credit_limit_minor")
  paymentTermsDays   Int?       @map("payment_terms_days")
  defaultCurrency    String?    @map("default_currency")
  taxTreatment       String     @default("STANDARD") @map("tax_treatment")
  creditHold         Boolean    @default(false) @map("credit_hold")
  active             Boolean    @default(true)
  tenant             Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  defaultBranch      Branch?    @relation("CustomerDefaultBranch", fields: [defaultBranchId], references: [id])
  ownerUser          User?      @relation("CustomerOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  documents          Document[]
  payments           Payment[]
  posSales           PosSale[]

  @@unique([tenantId, code])
  @@index([tenantId, name, active])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@index([tenantId, taxNumber])
  @@index([tenantId, ownerUserId])
  @@map("customers")
}

model Supplier {
  id               BigInt     @id @default(autoincrement())
  tenantId         BigInt     @map("tenant_id")
  code             String
  name             String
  taxNumber        String?    @map("tax_number")
  email            String?
  phone            String?
  address          String?
  city             String
  paymentTermsDays Int        @default(30) @map("payment_terms_days")
  active           Boolean    @default(true)
  tenant           Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents        Document[]
  payments         Payment[]

  @@unique([tenantId, code])
  @@index([tenantId, name])
  @@map("suppliers")
}

model ItemCategory {
  id       BigInt @id @default(autoincrement())
  tenantId BigInt @map("tenant_id")
  code     String
  name     String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items    Item[]

  @@unique([tenantId, code])
  @@map("item_categories")
}

model UnitOfMeasure {
  id            BigInt         @id @default(autoincrement())
  tenantId      BigInt         @map("tenant_id")
  code          String
  name          String
  precision     Int            @default(3)
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  items         Item[]
  documentLines DocumentLine[]

  @@unique([tenantId, code])
  @@map("units_of_measure")
}

model Item {
  id                 BigInt          @id @default(autoincrement())
  tenantId           BigInt          @map("tenant_id")
  categoryId         BigInt          @map("category_id")
  uomId              BigInt          @map("uom_id")
  sku                String
  barcode            String
  name               String
  nameAr             String          @map("name_ar")
  purchasePriceMinor BigInt          @map("purchase_price_minor")
  salePriceMinor     BigInt          @map("sale_price_minor")
  taxRateBps         Int             @default(1400) @map("tax_rate_bps")
  reorderMilli       BigInt          @default(0) @map("reorder_milli")
  active             Boolean         @default(true)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
