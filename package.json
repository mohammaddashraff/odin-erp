{
  "name": "odin-erp",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,cyan \"npm run dev -w @odin/api\" \"npm run dev -w @odin/web\"",
    "build": "npm run build -w @odin/api && npm run build -w @odin/web",
    "release:migrate": "npm run release:migrate -w @odin/api",
    "start": "concurrently -k -n api,web -c blue,cyan \"npm run start:prod -w @odin/api\" \"npm run start -w @odin/web\"",
    "lint": "npm run lint -w @odin/api && npm run lint -w @odin/web",
    "typecheck": "npm run lint",
    "test": "npm run test -w @odin/api",
    "test:unit": "npm exec --workspace @odin/api -- jest --runInBand --testPathIgnorePatterns=\"(?:database-controls|\\.database)\\.spec\\.ts$\"",
    "test:db": "npm exec --workspace @odin/api -- jest --runInBand --testPathPatterns=\"(?:database-controls|\\.database)\\.spec\\.ts$\"",
    "test:security": "npm exec --workspace @odin/api -- jest --runInBand --testPathPatterns=\"(?:permissions|authorization-denial\\.filter|mfa-security|deployment-config|request-logging\\.interceptor|access-governance|private-attachments(?:\\.database)?|company-governance\\.database|erp-authorization\\.database|payment-approval\\.database|database-controls|sales-workflow\\.database)\\.spec\\.ts$\"",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @odin/api",
    "db:validate": "prisma validate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "npm run db:migrate -w @odin/api",
    "db:seed": "npm run db:seed -w @odin/api",
    "db:reset": "npm run db:reset -w @odin/api",
    "integrity": "npm run integrity -w @odin/api",
    "security:audit": "node scripts/check-dependency-audit.mjs",
    "security:scan": "node scripts/security-scan.mjs",
    "i18n:audit": "node scripts/check-translations.mjs",
    "i18n:review": "node scripts/check-translations.mjs --report"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "concurrently": "10.0.4"
  }
}
